PUBLIC_URL=https://codex.sunny-string.cn/agents
LISTEN_ADDR=127.0.0.1:8086
DATABASE_PATH=/var/lib/remote-agent/remote-agent.db
DOWNLOADS_DIR=/opt/remote-agent/current/dist
# Public signup is always disabled; create accounts through an administrator.
STUN_URLS=stun:stun.l.google.com:19302
# Enable the existing loopback model gateway. Never put its token in this file.
CODEX_GATEWAY_URL=http://127.0.0.1:8088
CODEX_GATEWAY_TOKEN_FILE=/run/credentials/remote-agent.service/codex-gateway.token
CODEX_MODEL=gpt-6.1-sol
