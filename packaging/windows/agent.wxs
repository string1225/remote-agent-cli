<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Remote Agent" Language="2052" Codepage="936" Version="$(var.PackageVersion)"
           Manufacturer="Remote Agent" UpgradeCode="169D07FD-348F-4323-A695-0432D646790B">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="$(var.Platform)" />
    <!-- Stable component GUIDs/key paths let upgrades retain the service object
         and its SID/recovery policy, including when the file transaction rolls back. -->
    <MajorUpgrade Schedule="afterInstallExecute" DowngradeErrorMessage="A newer Remote Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="CLI_LANGUAGE" Value="en" Secure="yes" />
    <SetProperty Id="CLI_LANGUAGE" Value="zh" Before="CostFinalize" Sequence="both">SystemLanguageID = 4 OR SystemLanguageID = 1028 OR SystemLanguageID = 2052 OR SystemLanguageID = 3076 OR SystemLanguageID = 4100 OR SystemLanguageID = 5124 OR SystemLanguageID = 30724 OR SystemLanguageID = 31748</SetProperty>
    <Property Id="TOKEN_SETUP_COMMAND" Value="remote-agent codex setup" />
    <Property Id="DEVICE_SETUP_COMMAND" Value="https://codex.sunny-string.cn/agents" />
    <Property Id="AGENT_SETUP_ACTION" Value="安装" />
    <Property Id="AGENT_SETUP_TITLE" Value="安装 Remote Agent" />
    <Property Id="AGENT_SETUP_DESCRIPTION" Value="安装命令行工具与自动启动的 Windows Service，并将程序加入系统 PATH。&#13;&#10;&#13;&#10;安装后在网页登录账号，添加设备，将绑定命令复制到新的 PowerShell 执行。绑定会自动配置所属账号的 Token。退出登录后，已绑定的服务仍保持运行。" />
    <Property Id="AGENT_COMPLETE_TITLE" Value="安装完成 · 下一步绑定设备" />
    <SetProperty Id="AGENT_SETUP_ACTION" Action="SetAgentUpgradeAction" Value="升级" After="FindRelatedProducts" Sequence="ui">WIX_UPGRADE_DETECTED AND NOT Installed</SetProperty>
    <SetProperty Id="AGENT_SETUP_TITLE" Action="SetAgentUpgradeTitle" Value="升级 Remote Agent 至 [ProductVersion]" After="SetAgentUpgradeAction" Sequence="ui">WIX_UPGRADE_DETECTED AND NOT Installed</SetProperty>
    <SetProperty Id="AGENT_SETUP_DESCRIPTION" Action="SetAgentUpgradeDescription" Value="检测到本机已安装 Remote Agent。点击升级，将更新程序并保留现有设备绑定、配置、项目、会话和录音。&#13;&#10;&#13;&#10;升级期间后台服务会短暂重启；完成后无需重新绑定或重新设置 Token。" After="SetAgentUpgradeTitle" Sequence="ui">WIX_UPGRADE_DETECTED AND NOT Installed</SetProperty>
    <SetProperty Id="AGENT_COMPLETE_TITLE" Action="SetAgentUpgradeCompleteTitle" Value="升级完成 · 原绑定与数据已保留" After="SetAgentUpgradeDescription" Sequence="ui">WIX_UPGRADE_DETECTED AND NOT Installed</SetProperty>
    <SetProperty Id="AGENT_SETUP_ACTION" Action="SetAgentRepairAction" Value="修复" After="SetAgentUpgradeCompleteTitle" Sequence="ui">Installed</SetProperty>
    <SetProperty Id="AGENT_SETUP_TITLE" Action="SetAgentRepairTitle" Value="修复 Remote Agent [ProductVersion]" After="SetAgentRepairAction" Sequence="ui">Installed</SetProperty>
    <SetProperty Id="AGENT_SETUP_DESCRIPTION" Action="SetAgentRepairDescription" Value="本机已安装此版本 Remote Agent。点击修复，将恢复安装文件和服务注册，保留设备绑定、配置、项目、会话和录音。&#13;&#10;&#13;&#10;后台服务会短暂重启；修复完成后无需重新绑定。" After="SetAgentRepairTitle" Sequence="ui">Installed</SetProperty>
    <SetProperty Id="AGENT_COMPLETE_TITLE" Action="SetAgentRepairCompleteTitle" Value="修复完成 · 原绑定与数据已保留" After="SetAgentRepairDescription" Sequence="ui">Installed</SetProperty>
    <Condition Message="Remote Agent requires 64-bit Windows.">Installed OR VersionNT64</Condition>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="Remote Agent">
          <Component Id="AgentService" Guid="45D7DE9A-9EF3-44D1-9FA2-E73F3F551E54" Win64="yes">
            <File Id="AgentExe" Source="$(var.AgentBinary)" Name="remote-agent.exe" DefaultVersion="$(var.PackageVersion)" DefaultLanguage="1033" KeyPath="yes" />
            <ServiceInstall Id="AgentServiceInstall" Name="RemoteAgent" DisplayName="Remote Agent"
                            Description="Remote Agent device connection and local project services."
                            Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes"
                            Account="NT AUTHORITY\LocalService" Arguments="service run" />
            <ServiceControl Id="AgentServiceControl" Name="RemoteAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
            <ServiceInstall Id="UpdateServiceInstall" Name="RemoteAgentUpdater" DisplayName="Remote Agent Updater"
                            Description="Verifies signed runtime updates and preserves the fixed Remote Agent installation."
                            Type="ownProcess" Start="auto" ErrorControl="normal" Vital="yes" Arguments="update-service run" />
            <ServiceControl Id="UpdateServiceControl" Name="RemoteAgentUpdater" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
          </Component>
          <Directory Id="SEEDDIR" Name="seed">
            <Component Id="SeedRuntime" Guid="1B0C865B-B3DA-4C8B-B2B5-A67921AB48FC" Win64="yes">
              <File Id="SeedCore" Source="$(var.CoreBinary)" Name="remote-agent-core.exe" DefaultVersion="$(var.PackageVersion)" DefaultLanguage="1033" KeyPath="yes" />
            </Component>
          </Directory>
          <Component Id="InstallationRegistry" Guid="C9443878-4C38-4F10-BE23-D8EBD7E5C6D3" Win64="yes">
            <RegistryValue Root="HKLM" Key="SOFTWARE\RemoteAgent" Name="HostProtocol" Type="integer" Value="1" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\RemoteAgent" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
            <RegistryValue Root="HKLM" Key="SOFTWARE\RemoteAgent" Name="Language" Type="string" Value="[CLI_LANGUAGE]" />
            <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\RemoteAgent" Name="EventMessageFile" Type="expandable" Value="[System64Folder]EventCreate.exe" />
            <RegistryValue Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\RemoteAgent" Name="TypesSupported" Type="integer" Value="7" />
          </Component>
          <Component Id="CommandLinePath" Guid="CFC83CF3-177D-4C06-B56D-596EC77EA9DD" Win64="yes">
            <RegistryValue Root="HKLM" Key="SOFTWARE\RemoteAgent" Name="CommandLinePath" Type="string" Value="[INSTALLDIR]" KeyPath="yes" />
            <Environment Id="AgentMachinePath" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="first" System="yes" />
          </Component>
          <Component Id="License" Guid="8A41A940-5460-483F-A60C-072542C41330" Win64="yes">
            <File Id="LicenseFile" Source="$(var.SourceRoot)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
            <File Id="SetupHelp" Source="$(var.SourceRoot)\packaging\windows\SETUP.txt" Name="SETUP.txt" />
          </Component>
        </Directory>
      </Directory>
    </Directory>
    <Feature Id="Complete" Title="Remote Agent" Level="1">
      <ComponentRef Id="AgentService" />
      <ComponentRef Id="SeedRuntime" />
      <ComponentRef Id="InstallationRegistry" />
      <ComponentRef Id="CommandLinePath" />
      <ComponentRef Id="License" />
    </Feature>
    <CustomAction Id="PrepareAgentService" FileKey="AgentExe" ExeCommand="service prepare" Execute="deferred" Impersonate="no" Return="check" />
    <Binary Id="MaintenanceHost" SourceFile="$(var.AgentBinary)" />
    <CustomAction Id="CleanupRuntime" BinaryKey="MaintenanceHost" ExeCommand="runtime-cleanup" Execute="commit" Impersonate="no" Return="check" />
    <?ifdef var.InjectFailure?>
    <CustomAction Id="FailAcceptanceInstall" FileKey="AgentExe" ExeCommand="service invalid-installer-action" Execute="deferred" Impersonate="no" Return="check" />
    <?endif?>
    <InstallExecuteSequence>
      <Custom Action="PrepareAgentService" After="InstallServices">NOT REMOVE~="ALL"</Custom>
      <Custom Action="CleanupRuntime" After="InstallInitialize">REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
      <?ifdef var.InjectFailure?>
      <Custom Action="FailAcceptanceInstall" After="PrepareAgentService">NOT REMOVE~="ALL"</Custom>
      <?endif?>
    </InstallExecuteSequence>
    <UI Id="RemoteAgentUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Microsoft YaHei UI" Size="9" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Microsoft YaHei UI" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Microsoft YaHei UI" Size="10" Bold="yes" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="UserExit" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <TextStyle Id="Normal" FaceName="Microsoft YaHei UI" Size="9" />
      <TextStyle Id="Title" FaceName="Microsoft YaHei UI" Size="13" Bold="yes" />
      <Property Id="DefaultUIFont" Value="Normal" />
      <Dialog Id="AgentWelcome" Width="450" Height="270" Title="Remote Agent [AGENT_SETUP_ACTION]">
        <Control Id="Title" Type="Text" X="20" Y="18" Width="410" Height="28" Text="{\Title}[AGENT_SETUP_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="60" Width="410" Height="95" Text="[AGENT_SETUP_DESCRIPTION]" />
        <Control Id="DiskSpace" Type="Text" X="20" Y="175" Width="410" Height="35" Text="磁盘空间不足，请释放目标磁盘空间后重新运行安装器。">
          <Condition Action="show">OutOfDiskSpace = 1</Condition>
          <Condition Action="hide">NOT (OutOfDiskSpace = 1)</Condition>
        </Control>
        <Control Id="Install" Type="PushButton" X="290" Y="235" Width="65" Height="22" Default="yes" Text="[AGENT_SETUP_ACTION]">
          <Condition Action="disable">OutOfDiskSpace = 1</Condition>
          <Condition Action="enable">NOT (OutOfDiskSpace = 1)</Condition>
          <Publish Property="REINSTALL" Value="ALL" Order="1">Installed</Publish>
          <Publish Property="REINSTALLMODE" Value="amus" Order="2">Installed</Publish>
          <Publish Event="EndDialog" Value="Return" Order="3">1</Publish>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="365" Y="235" Width="65" Height="22" Cancel="yes" Text="取消">
          <Publish Event="EndDialog" Value="Exit">1</Publish>
        </Control>
      </Dialog>
      <Dialog Id="AgentProgress" Width="450" Height="270" Title="Remote Agent [AGENT_SETUP_ACTION]" Modeless="yes">
        <Control Id="Title" Type="Text" X="20" Y="25" Width="410" Height="28" TabSkip="no" Text="{\Title}正在[AGENT_SETUP_ACTION] Remote Agent" />
        <Control Id="Status" Type="Text" X="20" Y="90" Width="410" Height="45"><Subscribe Event="ActionText" Attribute="Text" /></Control>
        <Control Id="Progress" Type="ProgressBar" X="20" Y="145" Width="410" Height="18" ProgressBlocks="yes"><Subscribe Event="SetProgress" Attribute="Progress" /></Control>
      </Dialog>
      <Dialog Id="AgentComplete" Width="500" Height="330" Title="Remote Agent [AGENT_SETUP_ACTION]完成">
        <Control Id="Title" Type="Text" X="20" Y="15" Width="460" Height="28" Text="{\Title}[AGENT_COMPLETE_TITLE]" />
        <Control Id="Description" Type="Text" X="20" Y="52" Width="460" Height="45" Text="程序已加入系统 PATH。请打开新的 PowerShell；若使用 Windows Terminal，请完全退出后重新打开。选中下方命令按 Ctrl+C 复制。" />
        <Control Id="TokenLabel" Type="Text" X="20" Y="103" Width="460" Height="20" Text="1. 打开网页，登录后添加设备，复制绑定命令到这台电脑执行：" />
        <Control Id="TokenCommand" Type="Edit" X="20" Y="128" Width="460" Height="40" Property="DEVICE_SETUP_COMMAND" Multiline="yes" Sunken="yes" />
        <Control Id="DeviceLabel" Type="Text" X="20" Y="182" Width="460" Height="20" Text="2. 绑定后刷新配置并补装 Codex CLI（终端显示所属账号）：" />
        <Control Id="DeviceCommand" Type="Edit" X="20" Y="207" Width="460" Height="40" Property="TOKEN_SETUP_COMMAND" Multiline="yes" Sunken="yes" />
        <Control Id="Note" Type="Text" X="20" Y="259" Width="460" Height="22" Text="配置成功后运行 codex。升级已有设备无需重新绑定。此窗口由你关闭。" />
        <Control Id="Finish" Type="PushButton" X="410" Y="294" Width="70" Height="23" Default="yes" Cancel="yes" Text="完成">
          <Publish Event="EndDialog" Value="Return">1</Publish>
        </Control>
      </Dialog>
      <InstallUISequence>
        <Show Dialog="AgentWelcome" Before="AgentProgress">NOT RASKIPWELCOME AND NOT REMOVE~="ALL"</Show>
        <Show Dialog="AgentProgress" Before="ExecuteAction" />
        <Show Dialog="AgentComplete" OnExit="success">NOT REMOVE~="ALL"</Show>
      </InstallUISequence>
      <AdminUISequence>
        <Show Dialog="AgentComplete" OnExit="success">NOT REMOVE~="ALL"</Show>
      </AdminUISequence>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Product>
</Wix>
